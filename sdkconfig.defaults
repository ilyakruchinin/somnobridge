# SomnoBridge — ESP32-S3-GEEK base configuration
#
# This defaults file is the DEVELOPMENT profile: it enables the unprotected
# (plain) NVS path so firmware can boot on boards without a burned eFuse
# HMAC key. Production builds must set CONFIG_SOMNOBRIDGE_DEV_UNPROTECTED=n,
# in which case a missing HMAC key yields SECURITY_NOT_PROVISIONED and
# credentials are never written unencrypted (spec §4.2).

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partitions: evidence + metadata NVS rings (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Quad PSRAM — the GEEK ships ESP32-S3R2 (2 MiB Quad-SPI, 3.3 V;
# esptool reports it as "Embedded PSRAM 2MB (AP_3v3)"). Octal mode is
# for S3R8/R16V parts and would crash psram init before console.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 1024 (not the 16384 default): mid-size allocs (httpd/NVS/lwIP buffers)
# must not burn internal RAM — the WiFi driver needs ~10+ KB free internal
# for per-station attach/mgmt TX in SoftAP mode or clients see auth storms,
# and NimBLE SM pairing needs a ~10 KiB contiguous internal block for the
# ECC ladder (observed: esp-aes alloc failure -> disconnect reason 517).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 240 MHz: deflate/delta16 encoding, SHA-256 and the NimBLE host share
# the chip with WiFi+BLE; 160 MHz measured as the baseline is slow enough
# to matter for the compressed-stream pipeline (speed-optim.md D.3.1).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# NimBLE logs every notify at INFO ("GATT procedure initiated: notify") —
# hundreds of log calls per second in the stream hot path.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_LOG_LEVEL=2

# Core split (speed-optim.md D.3.1): BT host + controller stay on core 0;
# WiFi and lwIP move to core 1 with the stream/codec workers.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY=1

# 4xMSS window throttles EZShare GET throughput; buffers land in PSRAM
# (SPIRAM_TRY_ALLOCATE_WIFI_LWIP above) so internal RAM is untouched.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# BLE: NimBLE host, single connection, Secure Connections, persistent bonds
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# MSYS_1 = notify/indicate mbuf pool: file streams burst through notify.
# External alloc mode places these in PSRAM, so they can cover the whole
# stream credit window (~16 KB ≈ 64 in-flight frames) — a burst that
# overruns the pool drops ctrl indicates, including STREAM_END.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=192
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=32
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y

# WiFi: keep credentials in RAM only — sp_config NVS blob is the authority
CONFIG_ESP_WIFI_NVS_ENABLED=n

# NVS encryption via eFuse-backed HMAC scheme (no nvs_keys partition needed).
# Firmware checks the eFuse key is provisioned BEFORE calling secure init;
# it must never auto-burn a key (spec §4.2).
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=0

# Watchdog / brownout (spec §13.1)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_BROWNOUT_DET=y

# Timing granularity for the poll scheduler
CONFIG_FREERTOS_HZ=1000

# app_main orchestrates NVS/LCD/portal work; default 3584 is too tight once
# init + 1 Hz tick paths stack up.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Console on the native USB-Serial/JTAG (same /dev/ttyACM0 used for
# flashing+monitor). UART0 (GPIO43/44) is not wired to USB on the GEEK.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Development-only: allow plain NVS + warning banner when no eFuse key is
# provisioned. Must be off for production.
CONFIG_SOMNOBRIDGE_DEV_UNPROTECTED=y
# LESC P-256 math at -Og takes tens of seconds and overruns the 30 s SMP
# proc timer — compile performance, keep assertions.
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# NimBLE host task runs SMP crypto: keep mbedTLS — tinycrypt's RNG path
# issues a synchronous HCI rand from the host task and self-deadlocks;
# mbedTLS CTR_DRBG is seeded at init and is fast enough at -O2.
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=y
CONFIG_NIMBLE_CRYPTO_STACK_MBEDTLS=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=12288
# CONFIG_SOMNOBRIDGE_DIAG_FIXED_PASSKEY is not set
# NimBLE host allocations in PSRAM — internal RAM stayed <10KB free on
# v5.5.5 and NimBLE asserts on malloc failure (BLE_INIT: Malloc failed
# during connect, stream aborts). HCI/DMA transport bufs stay internal.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
